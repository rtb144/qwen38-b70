# z8g4 (Tom's lab): Ubuntu, Docker, mixed GPUs, dual-socket HP host.
# 88 cores, 231 GB RAM. Two Arc Pro B70 (BMG_G31_B70, 0xE223) at
# PCI 0000:17:00.0 (NUMA node 0) and 0000:9b:00.0 (NUMA node 1).
# The cards sit on different CPU sockets.
#
# Render nodes after the 2026-11-11 reboot:
#   17:00.0 -> renderD129   (B70, NUMA 0)
#   2f:00.0 -> renderD128
#   8f:00.0 -> renderD130
#   9b:00.0 -> renderD131   (B70, NUMA 1)
# These numbers can change on the next reboot. PCI addresses do not.
# Recheck with ./scripts/find-intel-render-nodes.sh, or:
#   ./scripts/resolve-dri-from-bypath.sh --write .env
# Also present: RTX 5060 Ti and other render nodes — do not bind all of /dev/dri.
# Existing llama.cpp slots: 8010 (b70a coder), 8012 (b70b reviewer), 8014 (test).
# Models: /opt/models/<model-name>/
# Host tools: xpu-smi, Level Zero 1.34.0
# Bring-up notes: docs/z8g4-bringup-2026-11-11.md

IMAGE_NAME=qwen38-b70:latest
CONTAINER_NAME=qwen38-b70-z8g4

HOST_MODELS_DIR=/opt/models/Qwen3.8-27B-GGUF
HOST_PORT=8016
PORT=8016

# Safe SYCL compile parallelism (see Dockerfile ARG BUILD_JOBS).
BUILD_JOBS=24

DRI_RENDER_0=/dev/dri/renderD129
DRI_RENDER_0_NAME=renderD129
DRI_RENDER_1=/dev/dri/renderD131
DRI_RENDER_1_NAME=renderD131
DRI_BYPATH_0=/dev/dri/by-path/pci-0000:17:00.0-render
DRI_BYPATH_0_NAME=pci-0000:17:00.0-render
DRI_BYPATH_1=/dev/dri/by-path/pci-0000:9b:00.0-render
DRI_BYPATH_1_NAME=pci-0000:9b:00.0-render

GPU_COUNT=2
CTX_SIZE=262144
CTX_SIZE_OVERRIDE=
PARALLEL=1
BATCH=8192
UBATCH=8192
THREADS=16

ENABLE_MTP=0
SPEC_DRAFT_N_MAX=5
DRAFT_THREADS=16
DRAFT_NGL=0
ENABLE_VISION=0

# Pre-downloaded weights: set 1 after the GGUF is already under HOST_MODELS_DIR
SKIP_DOWNLOAD=1

MODEL_REPO=ggml-org/Qwen3.8-27B-GGUF
MODEL_REV=0669b98607d47046c7c2b3f801011d54a08cfccf
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf
MODEL_SHA256=31629f53165ab6a7dad8c9847dcfd1fdf55829dac1e6e748f4a68581b0033d34

MTP_REPO=ggml-org/Qwen3.8-27B-GGUF
MTP_REV=0669b98607d47046c7c2b3f801011d54a08cfccf
MTP_FILE=mtp-Qwen3.8-27B-Q4_0.gguf
MTP_SHA256=
MMPROJ_FILE=mmproj-Qwen3.8-27B-Q8_0.gguf
MMPROJ_SHA256=

SHM_SIZE=8g

# Optional secrets: source from a secrets manager. Never commit values.
# HF_TOKEN=
# LLAMA_API_KEY=

# Cross-GPU SYCL communication. Uncommented, the entrypoint uses lab/upstream
# defaults: COMM_SINGLE_KERNEL=1, COMM_DIRECT_Q8=2, DEV2DEV_MEMCPY=0.
# GGML_SYCL_COMM_SINGLE_KERNEL=1
# GGML_SYCL_COMM_DIRECT_Q8=2
# GGML_SYCL_DEV2DEV_MEMCPY=0

# UNDER TEST, not yet verified — dual-socket workaround (B70s on NUMA 0 and 1).
# With the defaults above, TP2 hangs at the first GPU dispatch on this host.
# COMM_DIRECT_Q8=0 alone still hung. COMM_SINGLE_KERNEL=0 aborted with
# UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY in dev2dev_memcpy (ggml-sycl.cpp:1599).
# Next setting under test is host-forward copies (DEV2DEV_MEMCPY=2). See
# docs/z8g4-bringup-2026-11-11.md. Do not treat this profile as working.
# GGML_SYCL_COMM_SINGLE_KERNEL=0
# GGML_SYCL_COMM_DIRECT_Q8=0
# GGML_SYCL_DEV2DEV_MEMCPY=2
