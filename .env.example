# Copy to .env and edit. docker compose reads .env for interpolation.
# See examples/z8g4.env for Tom's lab host.
# Never put HF_TOKEN, LLAMA_API_KEY, or other secrets in a committed file.
# .env is gitignored; source tokens from a secrets manager at run time.

IMAGE_NAME=qwen38-b70:latest
CONTAINER_NAME=qwen38-b70

# Host directory mounted at /models in the container.
# On lab hosts this is typically /opt/models/<model-name>
HOST_MODELS_DIR=./models

# Published host port. 8010/8012/8014 are taken on z8g4.
HOST_PORT=8016
# Listen port inside the container (keep equal to HOST_PORT unless you have a reason).
PORT=8016

# SYCL compile job count (docker compose build arg). 24 is the safe default;
# -j88 froze z8g4 (88 cores, 231 GB RAM). -j24 finished in 287.9 s, ~40 GB RAM.
BUILD_JOBS=24

# GPU selection: pass only these render nodes (NOT all of /dev/dri).
# How to find them: ./scripts/find-intel-render-nodes.sh
# After a reboot, renderD* numbers can change. PCI by-path names are stable.
# Recheck with the finder script, or:
#   ./scripts/resolve-dri-from-bypath.sh --write .env
# Compose mounts the whole /dev/dri/by-path folder; DRI_BYPATH_* are kept
# here so the resolver knows which PCI addresses are the intended cards.
# Typical dedicated 2x B70 box (first two render nodes):
DRI_RENDER_0=/dev/dri/renderD128
DRI_RENDER_0_NAME=renderD128
DRI_RENDER_1=/dev/dri/renderD129
DRI_RENDER_1_NAME=renderD129
DRI_BYPATH_0=/dev/dri/by-path/pci-0000:03:00.0-render
DRI_BYPATH_0_NAME=pci-0000:03:00.0-render
DRI_BYPATH_1=/dev/dri/by-path/pci-0000:04:00.0-render
DRI_BYPATH_1_NAME=pci-0000:04:00.0-render

GPU_COUNT=2
CTX_SIZE=262144
# Blank = use CTX_SIZE (2 GPU) or 131072 (1 GPU) inside the entrypoint.
CTX_SIZE_OVERRIDE=
PARALLEL=1
BATCH=8192
UBATCH=8192
THREADS=16

# MTP speculative decoding (0=off). When on, n-max 5 is the lab sweet spot.
ENABLE_MTP=0
SPEC_DRAFT_N_MAX=5
DRAFT_THREADS=16
DRAFT_NGL=0

ENABLE_VISION=0

# 1 = do not call huggingface; require MODEL_FILE already on HOST_MODELS_DIR
SKIP_DOWNLOAD=0

# Pinned Qwen3.8-27B Q4_K_M (override for other GGUF models)
MODEL_REPO=ggml-org/Qwen3.8-27B-GGUF
MODEL_REV=0669b98607d47046c7c2b3f801011d54a08cfccf
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf
MODEL_SHA256=31629f53165ab6a7dad8c9847dcfd1fdf55829dac1e6e748f4a68581b0033d34

MTP_REPO=ggml-org/Qwen3.8-27B-GGUF
MTP_REV=0669b98607d47046c7c2b3f801011d54a08cfccf
MTP_FILE=mtp-Qwen3.8-27B-Q4_0.gguf
MTP_SHA256=
MMPROJ_FILE=mmproj-Qwen3.8-27B-Q8_0.gguf
MMPROJ_SHA256=

SHM_SIZE=8g

# Optional Hugging Face token for first-time downloads. Source from a secrets
# manager (or a local untracked .env). Never commit a token.
# HF_TOKEN=

# Optional llama-server API key (passed as --api-key when set). The server
# warns about CORS * when no key is configured.
# LLAMA_API_KEY=

# Cross-GPU SYCL communication (lab/upstream defaults). Leave unset to use
# these values. A commented dual-socket profile lives in examples/z8g4.env.
# GGML_SYCL_COMM_SINGLE_KERNEL=1
# GGML_SYCL_COMM_DIRECT_Q8=2
# GGML_SYCL_DEV2DEV_MEMCPY=0
